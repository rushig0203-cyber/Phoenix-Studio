+class TestPhoenixArtifacts(unittest.TestCase):
+    def test_master_preserves_uncaptioned_picture_and_exact_final_audio(self):
+        ffmpeg = imageio_ffmpeg.get_ffmpeg_exe()
+        with tempfile.TemporaryDirectory(prefix="phoenix-master-test-") as temporary:
+            directory = Path(temporary)
+            base, final = directory / "combined.mp4", directory / "final.mp4"
+            def run(arguments):
+                return subprocess.run([ffmpeg, "-v", "error", "-nostdin", "-y", *arguments], capture_output=True, check=True).stdout
+            run(["-f", "lavfi", "-i", "color=c=blue:s=160x90:r=12", "-t", "2", "-c:v", "libx264", "-threads", "1", str(base)])
+            run(["-f", "lavfi", "-i", "color=c=red:s=160x90:r=12", "-f", "lavfi", "-i", "sine=frequency=880:duration=2", "-t", "2", "-c:v", "libx264", "-threads", "1", "-c:a", "aac", str(final)])
+            captions = directory / "captions.srt"
+            captions.write_text("1\n00:00:00,000 --> 00:00:01,900\nOriginal words.\n", encoding="utf-8")
+            manifest = retain_artifacts(base, final, final, captions, ffmpeg)
+            self.assertFalse(manifest["music_present"])
+            self.assertEqual(manifest["caption_count"], 1)
+            self.assertEqual(read_artifacts(final), manifest)
+            def picture(file):
+                return run(["-i", str(file), "-map", "0:v:0", "-frames:v", "1", "-f", "rawvideo", "-pix_fmt", "rgb24", "-"])
+            self.assertEqual(picture(base), picture(manifest["clean_video"]))
+            self.assertNotEqual(picture(final), picture(manifest["clean_video"]))
+            def sound(file):
+                return run(["-i", str(file), "-map", "0:a:0", "-f", "s16le", "-"])
+            self.assertEqual(sound(final), sound(manifest["clean_video"]))
