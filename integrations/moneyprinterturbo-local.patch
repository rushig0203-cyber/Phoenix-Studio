+class TestPhoenixShotCache(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(prefix="phoenix-shot-cache-test-")
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.cache_dir = self.root / "cache"
+        self.ffmpeg = self.root / "ffmpeg-fixture"
+        self.ffmpeg.write_bytes(b"test encoder recipe")
+        self.source = self.root / "source.mp4"
+        self.source.write_bytes(b"test source content")
+        self.cache_patch = patch.object(storyboard, "_shot_cache_directory", return_value=self.cache_dir)
+        self.cache_patch.start()
+        self.addCleanup(self.cache_patch.stop)
+        self.shot = {"start": 0, "end": 1, "sourceStart": 0, "path": str(self.source)}
+        self.encoded_calls = []
+
+    def fake_render(self, arguments, **_kwargs):
+        destination = Path(arguments[-1])
+        if "-frames:v" in arguments:
+            frames = int(arguments[arguments.index("-frames:v") + 1])
+            self.encoded_calls.append(arguments)
+            destination.write_bytes(f"encoded picture frames:{frames}".encode())
+            return subprocess.CompletedProcess(arguments, 0, stdout=f"frame={frames}\n".encode(), stderr=b"")
+        destination.write_bytes(b"assembled fixture")
+        return subprocess.CompletedProcess(arguments, 0, stdout=b"", stderr=b"")
+
+    def render(self, shots=None, task="first", resolution=(160, 90)):
+        return storyboard.render_timeline(shots or [self.shot], self.root / task / "output.mp4", resolution, str(self.ffmpeg))
+
+    def test_changed_task_or_source_path_reuses_content_identical_shot(self):
+        copy = self.root / "other-task-source.mp4"
+        shutil.copyfile(self.source, copy)
+        with patch.object(storyboard.subprocess, "run", side_effect=self.fake_render):
+            self.render()
+            self.render([{**self.shot, "path": str(copy)}], task="second")
+        self.assertEqual(len(self.encoded_calls), 1)
+        self.assertEqual(len(list(self.cache_dir.glob("*.mp4"))), 1)
+
+    def test_failed_later_shot_keeps_successful_shot_for_next_attempt(self):
+        second = {**self.shot, "start": 1, "end": 2, "sourceStart": .5}
+        def fail_second(arguments, **kwargs):
+            if "-frames:v" in arguments and "0.5" in arguments:
+                raise subprocess.TimeoutExpired(arguments, 240)
+            return self.fake_render(arguments, **kwargs)
+        with patch.object(storyboard.subprocess, "run", side_effect=fail_second):
+            with self.assertRaises(subprocess.TimeoutExpired):
+                self.render([self.shot, second])
+        self.assertEqual(len(list(self.cache_dir.glob("*.mp4"))), 1)
+        with patch.object(storyboard.subprocess, "run", side_effect=self.fake_render):
+            self.render([self.shot, second], task="retry")
+        self.assertEqual(len(self.encoded_calls), 2)
+        self.assertFalse(list(self.root.glob("*/phoenix-shots-*")))
+
+    def test_source_offset_frame_count_format_and_encoder_changes_invalidate(self):
+        cache = storyboard._ShotCache(str(self.ffmpeg))
+        key = cache.key(self.shot, 30, (160, 90))
+        self.assertNotEqual(key, cache.key({**self.shot, "sourceStart": .1}, 30, (160, 90)))
+        self.assertNotEqual(key, cache.key(self.shot, 31, (160, 90)))
+        self.assertNotEqual(key, cache.key(self.shot, 30, (90, 160)))
+        self.source.write_bytes(b"changed source same path")
+        self.assertNotEqual(key, cache.key(self.shot, 30, (160, 90)))
+        self.ffmpeg.write_bytes(b"changed encoder")
+        original = cache.key(self.shot, 30, (160, 90))
+        self.assertNotEqual(original, storyboard._ShotCache(str(self.ffmpeg)).key(self.shot, 30, (160, 90)))
+
