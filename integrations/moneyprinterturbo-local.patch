+"""Retain exact editable media for Phoenix, without encoding the picture again."""
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+
+def retain_artifacts(video_path, final_path, audio_path, subtitle_path, ffmpeg, music_path=None, music_present=False):
+    from app.services.phoenix_storyboard import subtitle_cues
+
+    final = Path(final_path)
+    captions = subtitle_cues(subtitle_path) if subtitle_path else []
+    if not captions:
+        raise ValueError("Phoenix requires actual timed subtitles; no captionless success is allowed.")
+    clean = final.with_name(f"{final.stem}-clean.mp4")
+    temporary = clean.with_suffix(".partial.mp4")
+    flags = (subprocess.CREATE_NO_WINDOW | subprocess.BELOW_NORMAL_PRIORITY_CLASS) if os.name == "nt" else 0
+    try:
+        result = subprocess.run([ffmpeg, "-hide_banner", "-loglevel", "error", "-nostdin", "-y",
+            "-threads", "1", "-i", str(video_path), "-threads", "1", "-i", str(final),
+            "-map", "0:v:0", "-map", "1:a:0", "-c", "copy", "-shortest", "-movflags", "+faststart", str(temporary)],
+            capture_output=True, timeout=120, creationflags=flags)
+        if result.returncode:
+            raise ValueError("Could not retain clean narrated master: " + result.stderr.decode(errors="replace")[-500:])
+        os.replace(temporary, clean)
+    finally:
+        temporary.unlink(missing_ok=True)
+    retained_music = None
+    if music_present and music_path:
+        source = Path(music_path)
+        retained_music = final.with_name(f"{final.stem}-music{source.suffix}")
+        shutil.copyfile(source, retained_music)
+    manifest = {"version": 1, "clean_video": str(clean), "caption_file": str(subtitle_path),
+        "narration_file": str(audio_path), "music_present": bool(music_present),
+        "music_file": str(retained_music) if retained_music else None,
+        "caption_count": len(captions)}
+    destination = final.with_suffix(".artifacts.json")
+    temporary_json = destination.with_suffix(".tmp")
+    temporary_json.write_text(json.dumps(manifest), encoding="utf-8")
+    os.replace(temporary_json, destination)
+    return manifest
+
+
+def read_artifacts(final_path):
+    result = json.loads(Path(final_path).with_suffix(".artifacts.json").read_text(encoding="utf-8"))
+    if result.get("version") != 1:
+        raise ValueError("Phoenix editing artifacts were not saved.")
+    return result
