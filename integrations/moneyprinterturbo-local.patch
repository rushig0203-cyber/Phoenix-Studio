diff --git a/app/services/phoenix_storyboard.py b/app/services/phoenix_storyboard.py
new file mode 100644
index 0000000..6e74292
--- /dev/null
+++ b/app/services/phoenix_storyboard.py
@@ -0,0 +1,413 @@
+"""Narration-timed, stock-only edits. No synthetic fallback and no global footage loop."""
+
+import hashlib
+import json
+import math
+import os
+import re
+import shutil
+import subprocess
+import tempfile
+import time
+import uuid
+from pathlib import Path
+
+
+_SHOT_CACHE_BYTES = 256 * 1024 * 1024
+_SHOT_CACHE_FILES = 512
+_SHOT_CACHE_AGE = 7 * 24 * 60 * 60
+_SHOT_CACHE_NAME = re.compile(r"(?:shot-[0-9a-f]{64}\.(?:mp4|json)|\.tmp-shot-[0-9a-f]{32})\Z")
+
+
+def _shot_cache_directory():
+    from app.utils import utils
+
+    return Path(utils.storage_dir("phoenix_shot_cache"))
+
+
+def _file_digest(filename):
+    digest = hashlib.sha256()
+    with open(filename, "rb") as source:
+        for chunk in iter(lambda: source.read(256 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def _cache_regular_file(filename, directory):
+    # Cache cleanup may only touch our exact, flat filenames in this directory.
+    return (filename.parent.resolve() == directory.resolve()
+            and bool(_SHOT_CACHE_NAME.fullmatch(filename.name))
+            and not filename.is_symlink()
+            and not getattr(filename, "is_junction", lambda: False)()
+            and filename.is_file())
+
+
+def _prune_shot_cache(directory, reserve=0):
+    entries = []
+    for filename in directory.iterdir():
+        if _cache_regular_file(filename, directory):
+            stat = filename.stat()
+            entries.append((stat.st_mtime, stat.st_size, filename))
+    total, count, now = sum(item[1] for item in entries), len(entries), time.time()
+    for modified, size, filename in sorted(entries):
+        stale = modified < now - (_SHOT_CACHE_AGE if not filename.name.startswith(".tmp-") else 3600)
+        if stale or total + reserve > _SHOT_CACHE_BYTES or count + (2 if reserve else 0) > _SHOT_CACHE_FILES:
+            if _cache_regular_file(filename, directory):
+                filename.unlink()
+                total, count = total - size, count - 1
+
+
+class _ShotCache:
+    """Optional bounded disk reuse, never an admission requirement for rendering.
+
+    Content identity works across backend task directories. Timing uses the same
+    cumulative frame count as the encoder; moving an unchanged shot in a timeline
+    does not invalidate it unless its effective frame count changes.
+    """
+
+    def __init__(self, ffmpeg):
+        self.directory, self.source_digests = None, {}
+        try:
+            directory = _shot_cache_directory()
+            if directory.is_symlink() or getattr(directory, "is_junction", lambda: False)():
+                return
+            directory.mkdir(parents=True, exist_ok=True)
+            _prune_shot_cache(directory)
+            executable = Path(ffmpeg).resolve()
+            stat = executable.stat()
+            self.encoder = [str(executable), stat.st_size, stat.st_mtime_ns]
+            self.directory = directory
+        except (OSError, ValueError):
+            pass
+
+    def key(self, shot, frames, resolution):
+        if self.directory is None:
+            return None
+        try:
+            source = Path(shot["path"])
+            before = source.stat()
+            stamp = (str(source.resolve()), before.st_size, before.st_mtime_ns)
+            digest = self.source_digests.get(stamp)
+            if digest is None:
+                digest = _file_digest(source)
+                after = source.stat()
+                if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
+                    return None
+                self.source_digests[stamp] = digest
+            recipe = {"version": 2, "source": digest, "source_start": shot["sourceStart"], "stretch": shot.get("visualStretch", 1.0),
+                      "frames": frames, "resolution": list(resolution), "fps": 30,
+                      "filter": "reset-pts,scale-increase,crop,setsar,bounded-slowdown-eof", "codec": "libx264",
+                      "preset": "veryfast", "crf": 20, "pixel_format": "yuv420p",
+                      "encoder": self.encoder}
+            return hashlib.sha256(json.dumps(recipe, sort_keys=True).encode()).hexdigest()
+        except (OSError, ValueError):
+            return None
+
+    def restore(self, key, destination):
+        if self.directory is None or key is None:
+            return False
+        try:
+            video = self.directory / f"shot-{key}.mp4"
+            metadata = video.with_suffix(".json")
+            if not all(_cache_regular_file(file, self.directory) for file in (video, metadata)):
+                return False
+            if metadata.stat().st_size > 8192:
+                return False
+            record = json.loads(metadata.read_text(encoding="utf-8"))
+            if (not isinstance(record, dict) or record.get("key") != key
+                    or not 0 < video.stat().st_size == record.get("bytes", 0) <= _SHOT_CACHE_BYTES
+                    or not re.fullmatch(r"[0-9a-f]{64}", str(record.get("sha256", "")))):
+                return False
+            shutil.copyfile(video, destination)
+            # Validate the exact copied bytes, including same-size corruption.
+            if _file_digest(destination) != record["sha256"]:
+                return False
+            for file in (video, metadata):
+                os.utime(file, None)
+            return True
+        except (OSError, ValueError):
+            return False
+
+    def remember(self, key, source):
+        if self.directory is None or key is None:
+            return
+        staged = []
+        try:
+            size = source.stat().st_size
+            if not 0 < size < _SHOT_CACHE_BYTES - 8192:
+                return
+            _prune_shot_cache(self.directory, size + 8192)
+            video = self.directory / f"shot-{key}.mp4"
+            metadata = video.with_suffix(".json")
+            for _ in range(2):
+                staged.append(self.directory / f".tmp-shot-{uuid.uuid4().hex}")
+            shutil.copyfile(source, staged[0])
+            record = {"key": key, "bytes": size, "sha256": _file_digest(staged[0])}
+            staged[1].write_text(json.dumps(record), encoding="utf-8")
+            os.replace(staged[0], video)
+            os.replace(staged[1], metadata)
+            _prune_shot_cache(self.directory)
+        except (OSError, ValueError):
+            # A full/read-only/missing cache must never lose a successful render.
+            pass
+        finally:
+            for file in staged:
+                try:
+                    file.unlink(missing_ok=True)
+                except OSError:
+                    pass
+
+
+def words(text):
+    return re.findall(r"\w+", text.casefold().replace("’", "'"), re.UNICODE)
+
+
+def subtitle_cues(filename):
+    text = Path(filename).read_text(encoding="utf-8-sig")
+    pattern = re.compile(r"(\d+):(\d{2}):(\d{2})[,.](\d{3})\s*-->\s*(\d+):(\d{2}):(\d{2})[,.](\d{3})[^\n]*\n(.*?)(?=\n\s*\n|\Z)", re.S)
+    cues = []
+    for match in pattern.finditer(text):
+        values = list(map(int, match.groups()[:8]))
+        start = values[0] * 3600 + values[1] * 60 + values[2] + values[3] / 1000
+        end = values[4] * 3600 + values[5] * 60 + values[6] + values[7] / 1000
+        content = re.sub(r"<[^>]*>", "", match.group(9)).strip()
+        if end <= start or (cues and start < cues[-1][1] - 0.02):
+            raise ValueError("Storyboard needs ordered, non-overlapping speech captions.")
+        if words(content):
+            cues.append((start, end, content))
+    if not cues:
+        raise ValueError("No timed speech captions were produced; cannot align the footage.")
+    return cues
+
+
+def align_beats(beats, script, cues, duration):
+    """Use actual caption timestamps, with explicitly labelled within-cue interpolation."""
+    if not math.isfinite(duration) or duration <= 0:
+        raise ValueError("Storyboard requires a valid narration duration.")
+    script_words = words(script)
+    if not beats or [word for beat in beats for word in words(beat["narration"])] != script_words:
+        raise ValueError("Storyboard narration must cover the script exactly once, in order.")
+    if [word for _, _, text in cues for word in words(text)] != script_words:
+        raise ValueError("Speech captions do not match the narration. Retry the captions; no guessed stock timeline was created.")
+    if cues[-1][1] > duration + 0.3:
+        raise ValueError("Speech captions extend beyond the narration audio.")
+    positions = []
+    for start, end, text in cues:
+        count = len(words(text))
+        for index in range(count):
+            positions.append((start + (end - start) * index / count, index == 0))
+    result = []
+    offset = 0
+    for index, beat in enumerate(beats):
+        start, exact = (0.0, True) if index == 0 else positions[offset]
+        offset += len(words(beat["narration"]))
+        end, end_exact = (duration, True) if offset == len(positions) else positions[offset]
+        if end - start < 0.2:
+            raise ValueError(f"Narration section {index + 1} is too short for a readable shot.")
+        result.append({**beat, "start": start, "end": end, "timing": "subtitle-boundary" if exact and end_exact else "within-caption-estimate"})
+    return result
+
+
+def download_stock_video(candidate, directory):
+    """Bounded streaming staging; a provider response is never buffered in RAM."""
+    from moviepy import VideoFileClip
+    import requests
+    from app.config import config
+    from app.services import material
+    from app.utils import utils
+
+    destination = Path(directory or utils.storage_dir("cache_videos"))
+    destination.mkdir(parents=True, exist_ok=True)
+    filename = destination / f"vid-{utils.md5(candidate.url.split('?')[0])}.mp4"
+
+    def duration(file):
+        with VideoFileClip(str(file), audio=False) as clip:
+            value = float(clip.duration)
+        if not math.isfinite(value) or value < 0.3:
+            raise ValueError("Stock footage has no usable video duration.")
+        return value
+
+    if filename.exists() and filename.stat().st_size:
+        return str(filename), duration(filename)
+    temporary = None
+    try:
+        with requests.get(candidate.url, stream=True, proxies=config.proxy, verify=material._get_tls_verify(), timeout=(20, 120)) as response:
+            response.raise_for_status()
+            limit = 256 * 1024 * 1024
+            if int(response.headers.get("Content-Length") or 0) > limit:
+                raise ValueError("Stock file exceeds the 256 MB per-shot download limit.")
+            with tempfile.NamedTemporaryFile(dir=destination, suffix=".mp4", prefix="phoenix-download-", delete=False) as staged:
+                temporary = Path(staged.name)
+                received, deadline = 0, time.monotonic() + 180
+                for chunk in response.iter_content(chunk_size=1024 * 1024):
+                    received += len(chunk)
+                    if received > limit or time.monotonic() > deadline:
+                        raise ValueError("Stock download exceeded its size or time limit.")
+                    staged.write(chunk)
+            seconds = duration(temporary)
+            os.replace(temporary, filename)
+            temporary = None
+            return str(filename), seconds
+    finally:
+        if temporary is not None:
+            temporary.unlink(missing_ok=True)
+
+
+def approved_pexels_asset(asset_id, query):
+    """Resolve an approved ID through Pexels, never through a client-supplied URL."""
+    import requests
+    from urllib.parse import urlparse
+    from app.config import config
+    from app.services import material
+    from app.models.schema import MaterialInfo
+
+    response = requests.get(
+        f"https://api.pexels.com/v1/videos/videos/{int(asset_id)}",
+        headers={"Authorization": material.get_api_key("pexels_api_keys")},
+        proxies=config.proxy, verify=material._get_tls_verify(), timeout=(15, 30),
+        allow_redirects=False,
+    )
+    response.raise_for_status()
+    data = response.json()
+    if data.get("id") != asset_id:
+        raise ValueError("The approved Pexels asset is no longer available.")
+    files = [f for f in data.get("video_files", []) if f.get("file_type") == "video/mp4" and f.get("width", 0) > 0 and f.get("height", 0) > 0]
+    files.sort(key=lambda f: abs(min(f["width"], f["height"]) - 720))
+    if not files:
+        raise ValueError("The approved footage has no playable MP4.")
+    file = files[0]
+    url = urlparse(file["link"])
+    if url.scheme != "https" or not (url.hostname == "pexels.com" or (url.hostname or "").endswith(".pexels.com")) or url.username or url.password:
+        raise ValueError("Pexels returned an unsafe footage address.")
+    item = MaterialInfo()
+    item.provider, item.url, item.duration = "pexels", file["link"], data["duration"]
+    item.source_info = {"provider": "pexels", "asset_id": str(asset_id), "search_term": query,
+                        "source_page": material._safe_public_url(data.get("url")),
+                        "creator": material._creator_info(data.get("user")),
+                        "rendition": {"id": str(file.get("id", "")), "width": file["width"], "height": file["height"]}}
+    return item
+
+
+def prepare_timeline(task_id, params, subtitle_path, audio_duration, progress):
+    from app.config import config
+    from app.services import material, task_artifacts
+    from app.utils import utils
+
+    if params.video_source not in ("pexels", "pixabay") or params.video_count != 1:
+        raise ValueError("Phoenix storyboard accepts one stock-only Pexels/Pixabay export.")
+    beats = align_beats([beat.model_dump() for beat in params.phoenix_storyboard], params.video_script, subtitle_cues(subtitle_path), audio_duration)
+    search = material.search_videos_pexels if params.video_source == "pexels" else material.search_videos_pixabay
+    directory = config.app.get("material_directory", "").strip()
+    if directory == "task":
+        directory = utils.task_dir(task_id)
+    elif directory and not os.path.isdir(directory):
+        directory = ""
+    timeline, sources, used = [], [], set()
+    for index, beat in enumerate(beats):
+        progress(40 + 10 * index / len(beats), f"Finding footage for narration section {index + 1}/{len(beats)}")
+        approved_id = beat.get("assetId")
+        if approved_id:
+            if params.video_source != "pexels":
+                raise ValueError("Approved footage IDs require the Pexels source.")
+            candidates = [approved_pexels_asset(approved_id, beat["query"])]
+        else:
+            candidates = material._search_videos_with_cache(provider=params.video_source, search_videos=search, search_term=beat["query"], minimum_duration=1, video_aspect=params.video_aspect)
+        cursor = beat["start"]
+        for candidate in candidates[:20]:
+            info = candidate.source_info or {}
+            identity = str(info.get("asset_id") or candidate.url)
+            if identity in used:
+                continue
+            try:
+                filename, available = download_stock_video(candidate, directory)
+            except Exception as error:
+                if approved_id:
+                    raise ValueError(f"Approved footage for section {index + 1} could not be downloaded. It was not replaced.") from error
+                # Skip an unusable candidate, not the narration section itself.
+                continue
+            if not math.isfinite(available) or available < 0.3:
+                continue
+            used.add(identity)
+            source = material._material_source_record(candidate, filename)
+            sources.append(source)
+            # A tiny measured duration mismatch can use the same entire visual
+            # a little slower. Narration/audio timing remains unchanged. Large
+            # deficits still fail rather than repeating or borrowing footage.
+            remaining = beat["end"] - cursor
+            stretch = remaining / available
+            if approved_id and 1.0 < stretch <= 1.025:
+                timeline.append({**beat, "start": cursor, "end": beat["end"], "path": filename,
+                                 "sourceStart": 0.0, "sourcePage": source.get("source_page"),
+                                 "visualStretch": stretch, "timingAdjustment": "visual slowdown up to 2.5%; at most three end frames held for frame-rate rounding"})
+                cursor = beat["end"]
+                break
+            # Advance within this same source, never restart footage to pad a section.
+            source_start = 0.0
+            while source_start < available - 0.05 and cursor < beat["end"] - 0.001:
+                length = min(available - source_start, beat["end"] - cursor)
+                timeline.append({**beat, "start": cursor, "end": cursor + length, "path": filename, "sourceStart": source_start, "sourcePage": source.get("source_page")})
+                cursor += length
+                source_start += length
+            if cursor >= beat["end"] - 0.001:
+                break
+        if cursor < beat["end"] - 0.001:
+            raise ValueError(f"Section {index + 1} ({beat['query']}) has only {cursor - beat['start']:.1f}s of usable stock for {beat['end'] - beat['start']:.1f}s of narration. Change its visual search terms; unrelated or looped footage was not substituted.")
+    public = [{key: value for key, value in shot.items() if key not in ("path", "sourceStart")} for shot in timeline]
+    if not task_artifacts.patch_script_data(task_id, phoenix_storyboard=public, material_sources=sources):
+        raise ValueError("Could not save the storyboard and footage source records. Check available disk space and retry.")
+    return timeline, public
+
+
+def render_timeline(timeline, output_file, resolution, ffmpeg, progress=lambda *_: None):
+    """One low-priority FFmpeg process at a time; no Python-decoded frame pipeline."""
+    if not timeline or abs(timeline[0]["start"]) > 0.001:
+        raise ValueError("Storyboard must start at zero.")
+    for index, shot in enumerate(timeline):
+        if not all(math.isfinite(shot[key]) for key in ("start", "end", "sourceStart")) or shot["sourceStart"] < 0 or shot["end"] <= shot["start"]:
+            raise ValueError("Invalid storyboard shot timing.")
+        stretch = shot.get("visualStretch", 1.0)
+        if not isinstance(stretch, (float, int)) or not math.isfinite(stretch) or not 1.0 <= stretch <= 1.025:
+            raise ValueError("Storyboard visual slowdown exceeds the small timing-correction limit.")
+        if index and abs(shot["start"] - timeline[index - 1]["end"]) > 0.001:
+            raise ValueError("Storyboard contains a timing gap or overlap.")
+    width, height = resolution
+    flags = (subprocess.CREATE_NO_WINDOW | subprocess.BELOW_NORMAL_PRIORITY_CLASS) if os.name == "nt" else 0
+
+    def run(arguments):
+        result = subprocess.run([ffmpeg, "-hide_banner", "-loglevel", "error", "-nostdin", "-y", *arguments], capture_output=True, timeout=240, creationflags=flags)
+        if result.returncode:
+            raise ValueError("Storyboard FFmpeg failed: " + result.stderr.decode(errors="replace")[-700:])
+        return result
+
+    output = Path(output_file)
+    output.parent.mkdir(parents=True, exist_ok=True)
+    cache = _ShotCache(ffmpeg)
+    with tempfile.TemporaryDirectory(prefix="phoenix-shots-", dir=output.parent) as temporary:
+        parts = []
+        for index, shot in enumerate(timeline):
+            # Cumulative frame boundaries avoid per-shot rounding drift.
+            frames = round(shot["end"] * 30) - round(shot["start"] * 30)
+            if frames < 1:
+                raise ValueError(f"Storyboard shot {index + 1} has no output frames.")
+            part = Path(temporary) / f"shot-{index:03}.mp4"
+            cache_key = cache.key(shot, frames, resolution)
+            reused = cache.restore(cache_key, part)
+            if not reused:
+                # Older FFmpeg builds can drop the final one or two frames at
+                # resampling EOF. Bound correction to three frames, then verify
+                # the requested frame count. Never loop the source.
+                eof = ",tpad=stop_mode=clone:stop_duration=0.1" if shot.get("visualStretch", 1.0) > 1 else ""
+                encoded = run(["-threads", "1", "-ss", str(shot["sourceStart"]), "-i", shot["path"], "-an", "-sn", "-dn", "-vf", f"setpts=(PTS-STARTPTS)*{shot.get('visualStretch', 1.0)},scale={width}:{height}:force_original_aspect_ratio=increase,crop={width}:{height},setsar=1,fps=30{eof}", "-filter_threads", "1", "-frames:v", str(frames), "-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p", "-threads", "1", "-progress", "pipe:1", str(part)])
+                counts = re.findall(r"^frame=(\d+)", encoded.stdout.decode(errors="replace"), re.M)
+                if not counts or int(counts[-1]) != frames:
+                    raise ValueError(f"Storyboard shot {index + 1} ended before its narration section. Choose longer footage and retry.")
+                if cache_key == cache.key(shot, frames, resolution):
+                    cache.remember(cache_key, part)
+            parts.append(part.name)
+            progress(50 + 24 * (index + 1) / len(timeline), f"{'Reusing verified' if reused else 'Rendering timed'} shot {index + 1}/{len(timeline)}")
+        manifest = Path(temporary) / "concat.txt"
+        manifest.write_text("".join(f"file '{name}'\n" for name in parts), encoding="utf-8")
+        assembled = Path(temporary) / "combined.mp4"
+        run(["-f", "concat", "-safe", "1", "-i", str(manifest), "-c", "copy", "-movflags", "+faststart", str(assembled)])
+        os.replace(assembled, output)
+    return str(output)
