# Copy to .env.local. This file contains no credentials.
FREE_LOCAL_ONLY=1
OLLAMA_MODEL=qwen2.5:3b
MPT_BASE_URL=http://127.0.0.1:8080
MPT_API_TOKEN=
PHOENIX_RENDER_THREADS=2
PHOENIX_WHISPER_MODEL=base
# Optional: path to your Python environment containing faster-whisper.
PHOENIX_WHISPER_PYTHON=
# Blank uses the bundled executables installed by npm.
PHOENIX_FFMPEG_PATH=
PHOENIX_FFPROBE_PATH=
PHOENIX_KIDS_STOCK_BACKGROUNDS=0
# Optional free stock-provider keys. Never commit filled values.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional local singing adapter; engine/models are not bundled or installed.
# Disabled by Phoenix below 12 GB usable RAM or 4 GB currently free RAM.
# This does not enable singing on the current 8 GB laptop.
# PHOENIX_ACE_URL=http://127.0.0.1:8001
# PHOENIX_ACE_TOKEN=
# See integrations/FREE-CREATION.md before configuring a local engine.
